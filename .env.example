# Copy to .env and fill in. All values have safe dev defaults if omitted.

# --- Server ---
PORT=3000
NODE_ENV=development
# Secret used to sign admin session cookies. CHANGE THIS in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login (username + password) ---
# The password is hashed at startup; never stored in plaintext at rest.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=paint123

# --- Lead notifications ---
# Where new-lead / new-review emails go. TBD — leave blank to just log them.
OWNER_EMAIL=

# --- Outbound email (SMTP) ---
# Leave blank to run in "log only" mode (emails + portal codes print to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nassau Painting Co. <hello@nassaupainting.co>"

# --- Google Calendar sync (optional) ---
# When set: bookings appear on your Google Calendar, and the public scheduler
# hides any times you're already busy. Blank = log-only mode (still works).
# Setup (~5 min):
#   1. console.cloud.google.com -> new project -> enable "Google Calendar API"
#   2. Credentials -> Create OAuth client ID (type: Desktop app) -> copy ID + secret
#   3. developers.google.com/oauthplayground -> gear icon -> "Use your own OAuth
#      credentials" -> authorize scope https://www.googleapis.com/auth/calendar
#      -> Exchange authorization code for tokens -> copy the refresh token
#   4. Paste all three below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to write to ("primary" = your main calendar)
GOOGLE_CALENDAR_ID=primary
BUSINESS_TZ=America/New_York

# --- AI chat (optional, for later) ---
# When set, the chat assistant can call Claude. Left blank = guided scripted mode.
ANTHROPIC_API_KEY=
