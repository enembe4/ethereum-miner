# Copy to .env and fill in. All values have safe dev defaults if omitted.

# --- Server ---
PORT=3000
NODE_ENV=development
# Secret used to sign admin session cookies. CHANGE THIS in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login (username + password) ---
# The password is hashed at startup; never stored in plaintext at rest.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=paint123

# --- Lead notifications ---
# Where new-lead / new-review emails go. TBD — leave blank to just log them.
OWNER_EMAIL=

# --- Outbound email (SMTP) ---
# Leave blank to run in "log only" mode (emails + portal codes print to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nassau Painting Co. <hello@nassaupainting.co>"

# --- Google Calendar sync (optional) ---
# When set: bookings appear on your Google Calendar, and the public scheduler
# hides any times you're already busy. Blank = log-only mode (still works).
# Setup (~5 min):
#   1. console.cloud.google.com -> new project -> enable "Google Calendar API"
#   2. Credentials -> Create OAuth client ID (type: Desktop app) -> copy ID + secret
#   3. developers.google.com/oauthplayground -> gear icon -> "Use your own OAuth
#      credentials" -> authorize scope https://www.googleapis.com/auth/calendar
#      -> Exchange authorization code for tokens -> copy the refresh token
#   4. Paste all three below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to write to ("primary" = your main calendar)
GOOGLE_CALENDAR_ID=primary
BUSINESS_TZ=America/New_York

# --- AI chat ---
# When set, the website chat becomes a real Claude assistant: it answers
# questions about services/area/process, never quotes prices, and files
# qualified leads straight into the pipeline. Blank = guided scripted mode.
# Get a key at console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Model for the chat assistant (default claude-opus-5).
CHAT_MODEL=

# ---- AI visualizer (optional) --------------------------------------------
# Claude resolves any brand color ("Behr Blank Canvas", "SW 7069") and reads
# the customer's photo; a dedicated image-editing model performs the actual
# photorealistic repaint (Claude itself does not output images). Configure ONE
# render provider; without a key the visualizer runs its on-device instant
# preview only. Photos are processed in memory — never stored.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# VISUAL_RENDER_PROVIDER=gemini        # gemini | openai (auto-picked from keys)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1
# VISUAL_COLOR_MODEL=claude-haiku-4-5-20251001   # color lookup (fast/cheap)
# VISUAL_VISION_MODEL=claude-opus-5              # photo-reading edit brief
